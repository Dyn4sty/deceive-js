{
  "name": "deceive-js",
  "version": "2.2.0",
  "description": "Appear offline in League of Legends, TFT, VALORANT, and Legends of Runeterra. A Bun + Electrobun port of Deceive.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "hutch run dev",
    "build": "hutch run build",
    "build:canary": "hutch run build:canary",
    "prepare:devkit": "hutch electrobun prepare",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "prepare": "husky || true"
  },
  "dependencies": {
    "conf": "^13.0.1",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/node-forge": "^1.3.11",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "resedit": "^3.1.1",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Dyn4sty/deceive-js.git"
  },
  "keywords": [
    "league-of-legends",
    "valorant",
    "legends-of-runeterra",
    "offline",
    "presence",
    "riot-games",
    "deceive",
    "bun",
    "electrobun"
  ],
  "author": "",
  "license": "GPL-3.0",
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
